# Keep the build context small: don't ship local virtualenvs, VCS history,
# caches, build artifacts or secrets to the Docker daemon / into the image.
.git
.gitignore
venv/
.venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
staticfiles/
node_modules/
.env
.env.example
*.sqlite3
.ruff_cache/
.pytest_cache/
.mypy_cache/
.DS_Store
